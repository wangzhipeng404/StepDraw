<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：顶部信息栏 + 中间画布（正方形居中）+ 右侧操作栏 + 底部工具栏
     布局与 iPad 版 MainView 对齐 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/canvas_bg">

    <!-- ===== 顶部栏 ===== -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:background="@color/bar_bg">

        <TextView
            android:id="@+id/tv_pattern_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一笔一笔"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_step_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_mode"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="绘制"
            android:textSize="13sp"
            android:background="@drawable/chip_bg" />

        <TextView
            android:id="@+id/btn_pattern"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp"
            android:text="图案"
            android:textSize="13sp"
            android:background="@drawable/chip_bg" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:text="↺"
            android:textSize="17sp"
            android:background="@drawable/chip_bg" />
    </LinearLayout>

    <!-- ===== 中间画布区域（画布 gravity 居中，右侧栏悬浮覆盖）===== -->
    <FrameLayout
        android:id="@+id/main_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 三层离屏渲染画布（正方形，gravity 居中；尺寸代码里设置） -->
        <com.stepdraw.android.drawing.CanvasHostView
            android:id="@+id/canvas"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center" />

        <!-- 右侧操作栏：保存/分享/撤销/清空 -->
        <LinearLayout
            android:id="@+id/right_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/right_bar_bg">

            <TextView
                android:id="@+id/btn_save"
                style="@style/SideBtn"
                android:text="保存" />

            <TextView
                android:id="@+id/btn_share"
                style="@style/SideBtn"
                android:text="分享" />

            <View
                android:layout_width="22dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33000000" />

            <TextView
                android:id="@+id/btn_undo"
                style="@style/SideBtn"
                android:text="撤销" />

            <TextView
                android:id="@+id/btn_clear"
                style="@style/SideBtn"
                android:text="清空" />
        </LinearLayout>

        <!-- 空白画布提示（顶栏下方，不挡绘制） -->
        <LinearLayout
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/hint_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎  空白画布，直接开画"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btn_empty_pick"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:layout_marginStart="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="或选择图案临摹"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/chip_accent" />
        </LinearLayout>

        <!-- 缩放指示（画布右上角，短暂显示） -->
        <TextView
            android:id="@+id/scale_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/hint_bg"
            android:visibility="gone" />

        <!-- 图案加载遮罩 -->
        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/hint_bg">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="图案加载中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Toast -->
        <TextView
            android:id="@+id/toast_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/toast_bg"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== 底部工具栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bar_bg"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <!-- 上排：播放控制 + 进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/btn_guide"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="轮廓"
                android:textSize="12sp"
                android:background="@drawable/chip_bg_active" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#33000000" />

            <TextView
                android:id="@+id/btn_prev"
                style="@style/TransportBtn"
                android:text="◀︎" />

            <TextView
                android:id="@+id/btn_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="▶︎"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/circle_accent" />

            <TextView
                android:id="@+id/btn_next"
                style="@style/TransportBtn"
                android:text="▶︎" />

            <TextView
                android:id="@+id/btn_replay"
                style="@style/TransportBtn"
                android:text="↺︎" />

            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:text="1x"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/circle_chip" />

            <SeekBar
                android:id="@+id/seek_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:max="1000"
                android:progress="0" />
        </LinearLayout>

        <!-- 下排：画笔（颜色 / 粗细 / 笔种） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/palette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View android:id="@+id/pal_0" style="@style/ColorDot" />
                <View android:id="@+id/pal_1" style="@style/ColorDot" />
                <View android:id="@+id/pal_2" style="@style/ColorDot" />
                <View android:id="@+id/pal_3" style="@style/ColorDot" />
                <View android:id="@+id/pal_4" style="@style/ColorDot" />
                <View android:id="@+id/pal_5" style="@style/ColorDot" />
                <!-- 自定义色 -->
                <FrameLayout
                    android:id="@+id/pal_custom"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/color_dot_rainbow" />
                </FrameLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#33000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="粗细"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <SeekBar
                android:id="@+id/seek_width"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:max="23"
                android:progress="3" />

            <TextView
                android:id="@+id/tv_width"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="4"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#33000000" />

            <TextView
                android:id="@+id/brush_pen"
                style="@style/BrushBtn"
                android:text="钢笔" />

            <TextView
                android:id="@+id/brush_pencil"
                style="@style/BrushBtn"
                android:text="铅笔" />

            <TextView
                android:id="@+id/brush_marker"
                style="@style/BrushBtn"
                android:text="马克" />

            <TextView
                android:id="@+id/brush_brush"
                style="@style/BrushBtn"
                android:text="毛笔" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_gesture_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单指绘制 · 双指缩放/移动"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
