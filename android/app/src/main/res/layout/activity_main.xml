<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：全屏画布 + 左侧抽屉式图案浏览（与 web 端 DrawingStudio 布局一致）
     顶栏：logo(展开抽屉) + 绘制/移动 + 笔种图标 + 自定义颜色 + 粗细 + 撤销/清除/复位
     右侧：全高操作栏（保存/分享）
     底部：播放控制（轮廓/上一步/播放/下一步/重播/倍速/进度条）
     画布：全屏矩形，图案按适配变换居中留边距，边距区也能画 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/canvas_bg">

    <!-- ===== 顶部栏（绘画工具，单行；logo 在最左，工具区可横向滚动，与 web studio-top 的 overflow-x:auto 一致）===== -->
    <FrameLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bar_bg">

        <!-- logo（点击展开左侧图案抽屉） -->
        <ImageView
            android:id="@+id/iv_logo"
            style="@style/LogoBtn"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="10dp"
            android:src="@drawable/logo"
            android:contentDescription="一笔一笔" />

        <!-- 工具区（logo 之后，内容不够宽时横向滚动，避免窄屏上笔种图标被裁掉） -->
        <HorizontalScrollView
            android:id="@+id/top_tools_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="8dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="46dp">

            <!-- 笔种图标（钢笔/铅笔/马克/毛笔；点已选中的笔 → 退出绘制回到移动模式） -->
            <ImageView
                android:id="@+id/iv_brush_pen"
                style="@style/BrushIconBtn"
                android:src="@drawable/fountain_pen"
                android:contentDescription="钢笔" />

            <ImageView
                android:id="@+id/iv_brush_pencil"
                style="@style/BrushIconBtn"
                android:src="@drawable/pencil"
                android:contentDescription="铅笔" />

            <ImageView
                android:id="@+id/iv_brush_marker"
                style="@style/BrushIconBtn"
                android:src="@drawable/markpen"
                android:contentDescription="马克笔" />

            <ImageView
                android:id="@+id/iv_brush_brush"
                style="@style/BrushIconBtn"
                android:src="@drawable/ink_brush"
                android:contentDescription="毛笔" />

            <!-- 自定义颜色（圆点显示当前色，点击取色） -->
            <View
                android:id="@+id/color_dot"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ripple_circle" />

            <!-- 粗细（滑块 + 数值，无"粗细"文字） -->
            <SeekBar
                android:id="@+id/seek_width"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:max="23"
                android:progress="3" />

            <TextView
                android:id="@+id/tv_width"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="4"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:background="#33000000" />

            <!-- 撤销 / 清除 / 复位 -->
            <ImageView
                android:id="@+id/iv_undo"
                style="@style/TopIconBtn"
                android:src="@drawable/undo"
                android:contentDescription="撤销" />

            <ImageView
                android:id="@+id/iv_clear"
                style="@style/TopIconBtn"
                android:src="@drawable/clear"
                android:contentDescription="清除" />

            <ImageView
                android:id="@+id/iv_reset"
                style="@style/TopIconBtn"
                android:src="@drawable/reset"
                android:contentDescription="复位视图" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>

    <!-- ===== 画布区域（画布全屏，抽屉叠在左侧，右栏全高）===== -->
    <FrameLayout
        android:id="@+id/main_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 三层离屏渲染画布（填满 main_area，矩形） -->
        <com.stepdraw.android.drawing.CanvasHostView
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 图案抽屉：常驻左侧，默认 GONE；宽度代码里按屏幕比例设置 -->
        <com.stepdraw.android.PatternBrowserPane
            android:id="@+id/left_pane"
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:elevation="8dp"
            android:visibility="gone" />

        <!-- 右侧操作栏：全高（保存/分享） -->
        <LinearLayout
            android:id="@+id/right_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:gravity="top"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:background="#F5FFFFFF">

            <ImageView
                android:id="@+id/btn_save"
                style="@style/SideIconBtn"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/save"
                android:contentDescription="保存" />

            <ImageView
                android:id="@+id/btn_share"
                style="@style/SideIconBtn"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/share"
                android:contentDescription="分享" />
        </LinearLayout>

        <!-- 缩放指示（画布右上角，短暂显示） -->
        <TextView
            android:id="@+id/scale_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="56dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/hint_bg"
            android:visibility="gone" />

        <!-- 步骤提示（画布右下角，与 web studio-step-tip 一致） -->
        <TextView
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="56dp"
            android:layout_marginBottom="14dp"
            android:maxWidth="260dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/toast_bg"
            android:visibility="gone" />

        <!-- 图案加载遮罩 -->
        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/hint_bg">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="图案加载中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Toast -->
        <TextView
            android:id="@+id/toast_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/toast_bg"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== 底部工具栏（仅播放控制 + 进度条）===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bar_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- 轮廓开关 -->
        <ImageView
            android:id="@+id/btn_guide"
            style="@style/TransportIconBtn"
            android:src="@drawable/cat_solid_active"
            android:contentDescription="轮廓" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#33000000" />

        <ImageView
            android:id="@+id/btn_prev"
            style="@style/TransportIconBtn"
            android:src="@drawable/pre"
            android:contentDescription="上一步" />

        <ImageView
            android:id="@+id/btn_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/play"
            android:background="@drawable/ripple_circle"
            android:contentDescription="播放" />

        <ImageView
            android:id="@+id/btn_next"
            style="@style/TransportIconBtn"
            android:src="@drawable/next"
            android:contentDescription="下一步" />

        <ImageView
            android:id="@+id/btn_replay"
            style="@style/TransportIconBtn"
            android:src="@drawable/refresh"
            android:contentDescription="重播" />

        <TextView
            android:id="@+id/btn_speed"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="1x"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/circle_chip" />

        <SeekBar
            android:id="@+id/seek_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:max="1000"
            android:progress="0" />
    </LinearLayout>
</LinearLayout>
