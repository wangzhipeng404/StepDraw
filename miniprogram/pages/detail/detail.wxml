<!-- 一笔一笔 StepDraw - 小程序详情页 -->
<view class="detail">
  <!-- 画布区 -->
  <view class="canvas-container">
    <canvas
      type="2d"
      id="drawingCanvas"
      class="drawing-canvas"
      style="width: {{canvasSize}}px; height: {{canvasSize}}px;"
    ></canvas>
    <!-- 步骤提示固定在右下角 -->
    <view class="step-tip-overlay">
      <text class="tip-text">{{drawing && drawing.steps[currentStep] ? drawing.steps[currentStep].tip : ''}}</text>
    </view>
  </view>

  <!-- 播放控制栏 -->
  <view class="control-bar">
    <view class="control-btn-row">
      <view class="control-btn outline-btn {{showOutline ? 'active' : ''}}" bindtap="onToggleOutline">
        <text class="outline-text">轮廓</text>
      </view>
      <view class="control-btn" bindtap="onPrevStep">
        <image class="btn-icon" src="/images/pre.png" mode="aspectFit" />
      </view>
      <view class="control-btn play-btn {{playing ? 'playing' : ''}}" bindtap="onTogglePlay">
        <image class="btn-icon" src="{{playing ? '/images/stop.png' : '/images/play.png'}}" mode="aspectFit" />
      </view>
      <view class="control-btn" bindtap="onNextStep">
        <image class="btn-icon" src="/images/next.png" mode="aspectFit" />
      </view>
      <view class="control-btn" bindtap="onReset">
        <image class="btn-icon" src="/images/replay.png" mode="aspectFit" />
      </view>
      <view class="control-btn speed-btn" bindtap="onSpeedChange">
        <text class="speed-text">{{speedText}}x</text>
      </view>
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress-container">
    <slider
      class="progress-bar"
      min="0"
      max="1"
      step="0.01"
      value="{{globalProgress}}"
      block-size="16"
      block-color="#aa3bff"
      active-color="#aa3bff"
      background-color="#e0e0e0"
      bindchange="onProgressChange"
    />
  </view>
</view>
