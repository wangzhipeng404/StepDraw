/* 一笔一笔 StepDraw - 小程序详情页样式 */
.detail {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fafafa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.back-btn, .favorite-btn {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  border: none;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.canvas-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.drawing-canvas {
  background: #fff;
  width: 100%;
  height: 100%;
}

.step-tip-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.control-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.control-btn-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.control-btn {
  width: 88rpx;
  height: 88rpx;
  border: none;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  width: 80rpx;
  height: 80rpx;
}

.speed-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
}

.outline-btn {
  width: auto;
  min-width: 86rpx;
  height: 86rpx;
  border: 1px solid #000;
}

.outline-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
}
.outline-btn.active {
  border: 1px solid #aa3bff;
}

.outline-btn.active .outline-text {
  color: #aa3bff;
}

.play-btn {
  background: #f5f5f5;
}

.control-options {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
}

.switch-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.switch-group text {
  font-size: 26rpx;
}

.small-switch {
  transform: scale(0.8);
  transform-origin: center;
}

.progress-container {
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
