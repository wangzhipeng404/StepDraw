/* 一笔一笔 StepDraw - 小程序详情页样式 */
.detail {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fafafa;
}

/* 主内容区域 - 用于横屏布局 */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 画布区域 */
.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.canvas-container {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  height: 100%;
}

.drawing-canvas {
  background: #fff;
  width: 100%;
  height: 100%;
}

/* 三层画布叠放容器：相对定位，内部三层绝对定位完全重合 */
.canvas-stack {
  position: relative;
  background: #fff;
  border-radius: 8rpx;
  overflow: hidden;
}

.canvas-stack .drawing-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 覆盖层（用户绘制）保持透明，让下层图案透出 */
.canvas-stack .drawing-canvas + .drawing-canvas {
  background: transparent;
}

/* 步骤提示固定在右下角 */
.step-tip-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  z-index: 10;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 填充失败提示：画布顶部居中，轻量，自动消失 */
.fill-hint-overlay {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 10rpx 24rpx;
  background: rgba(0, 0, 0, 0.72);
  border-radius: 999rpx;
  z-index: 12;
  pointer-events: none;
}

.fill-hint-text {
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
}

/* 右上角最边缘：视图复位按钮（正方形，贴合卡片右上角） */
.view-reset-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  border-top-right-radius: 16rpx;
  border-bottom-left-radius: 12rpx;
  z-index: 10;
}

.view-reset-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 复位按钮左侧：模式快捷切换按钮（绘制 <-> 缩放/移动） */
.mode-toggle-btn {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  z-index: 10;
  border-top-left-radius: 16rpx;
}

.mode-toggle-btn:active {
  background: #f0f0f0;
}

.mode-toggle-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 工具栏区域 - 用于横屏布局 */
.toolbar-wrapper {
  width: auto;
  background: #fff;
  border-left: none;
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  height: auto;
}

/* 播放控制栏 */
.control-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.back-btn, .favorite-btn {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  border: none;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.canvas-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.drawing-canvas {
  background: #fff;
  width: 100%;
  height: 100%;
}

.step-tip-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.control-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.control-btn-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.control-btn {
  width: 72rpx;
  height: 72rpx;
  border: none;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  width: 56rpx;
  height: 56rpx;
  position: relative;
}

.speed-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #000;
}

/* 轮廓按钮样式 */
.outline-btn {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #8a8a8a;
  background: #f5f5f5;
  padding: 0;
  overflow: hidden;
}

.outline-btn.active {
  border: 1rpx solid #1890ff;
}

.outline-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 横屏模式按钮样式 */
.landscape-btn {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #8a8a8a;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  overflow: hidden;
}

.landscape-btn.active {
  border: 1rpx solid #1890ff;
  background: #e6f7ff;
}

.landscape-icon {
  width: 48rpx;
  height: 48rpx;
}

.play-btn {
  background: #f5f5f5;
}

.playing {
  background: #1890ff;
}

.control-options {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
}

.switch-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.switch-group text {
  font-size: 26rpx;
}

.small-switch {
  transform: scale(0.8);
  transform-origin: center;
}

.progress-container {
  padding: 0 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

/* 颜色选择器 */
.color-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.color-item {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid #eee;
}

.color-item.active {
  border: 4rpx solid #aa3bff;
}

.color-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

/* 笔画粗细选择器 */
.stroke-width-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.stroke-width-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.stroke-width-item.active {
  background: #f0f0f0;
  border-color: #aa3bff;
  box-shadow: 0 0 8rpx rgba(170, 91, 255, 0.4);
}

.stroke-circle {
  border-radius: 50%;
  background: #000;
}

/* 画笔类型选择器 */
.stroke-type-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.stroke-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1px solid transparent;
}

.stroke-type-item.active {
  background: #f0f0f0;
  border-color: #aa3bff;
}

.stroke-type-icon {
  width: 48rpx;
  height: 48rpx;
}

.stroke-type-name {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 绘图工具栏 */
.draw-tools-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.draw-tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #1e88e5;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  line-height: 1;
}

.draw-tool-btn:active {
  background: #e0e0e0;
}

.tool-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 分享按钮是 <button> 元素，需额外重置小程序按钮默认样式
   （默认块级撑满宽度、自带边距/内边距/字号/::after 边框与按压底色） */
button.draw-tool-btn.share-btn {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  font-size: 0;
  line-height: 1;
  color: transparent;
  border: 2rpx solid #1e88e5;
  border-radius: 50%;
  background: #f5f5f5;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

button.draw-tool-btn.share-btn::after {
  border: none;
}

button.draw-tool-btn.share-btn:active {
  background: #e0e0e0;
}

/* 响应式样式 - 竖屏/移动端布局 */
@media (max-width: 900px) or (orientation: portrait) {
  .main-content {
    flex-direction: column;
  }

  .canvas-wrapper {
    flex: none;
    width: auto;
    height: auto;
    margin: 20rpx;
    padding: 20rpx;
  }

  .toolbar-wrapper {
    width: auto;
    border-left: none;
    border-top: 1rpx solid #eee;
    height: auto;
  }

  .control-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .control-bar.landscape-toolbar .control-bar {
    border-bottom: 1rpx solid #eee;
    border-top: none;
  }

  .progress-container {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .color-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .stroke-width-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .stroke-type-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .draw-tools-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }
}

/* ============ 自定义颜色入口 ============ */
.custom-color-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-color-plus {
  color: #fff;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 0.6),
    1rpx 0 0 rgba(0, 0, 0, 0.4),
    -1rpx 0 0 rgba(0, 0, 0, 0.4),
    0 1rpx 0 rgba(0, 0, 0, 0.4),
    0 -1rpx 0 rgba(0, 0, 0, 0.4);
}

/* ============ 笔画粗细滑动条（工具栏内联） ============ */
.width-slider {
  flex: 1;
  min-width: 0;
}

/* ============ 自定义颜色弹层（遮罩） ============ */
.cp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}

/* ============ 自定义颜色弹层（面板） ============ */
/* 默认按横屏：从右侧滑入 */
.cp-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320rpx;
  background: #fff;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  box-shadow: -4rpx 0 24rpx rgba(0, 0, 0, 0.18);
}

.cp-panel.open {
  transform: translateX(0);
}

.cp-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.cp-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.cp-panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #999;
  line-height: 1;
}

.cp-panel-body {
  flex: 1;
  box-sizing: border-box;
}

.cp-panel-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}

.cp-footer-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.cp-footer-btn.cancel {
  background: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
}

.cp-footer-btn.confirm {
  background: #aa3bff;
  color: #fff;
}

/* 竖屏：改为从底部滑出 */
@media (max-width: 900px) or (orientation: portrait) {
  .cp-panel {
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.18);
    transform: translateY(100%);
  }

  .cp-panel.open {
    transform: translateY(0);
  }
}
