/* 一笔一笔 StepDraw - 小程序详情页样式 */
.detail {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fafafa;
}

/* 主内容区域 - 用于横屏布局 */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 画布区域 */
.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.canvas-container {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  height: 100%;
}

.drawing-canvas {
  background: #fff;
  width: 100%;
  height: 100%;
}

/* 步骤提示固定在右下角 */
.step-tip-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  z-index: 10;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 工具栏区域 - 用于横屏布局 */
.toolbar-wrapper {
  width: auto;
  background: #fff;
  border-left: none;
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  height: auto;
}

/* 播放控制栏 */
.control-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.back-btn, .favorite-btn {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  border: none;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.canvas-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.drawing-canvas {
  background: #fff;
  width: 100%;
  height: 100%;
}

.step-tip-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.control-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.control-btn-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.control-btn {
  width: 72rpx;
  height: 72rpx;
  border: none;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  width: 56rpx;
  height: 56rpx;
  position: relative;
}

.speed-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #000;
}

/* 轮廓按钮样式 */
.outline-btn {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #8a8a8a;
  background: #f5f5f5;
  padding: 0;
  overflow: hidden;
}

.outline-btn.active {
  border: 1rpx solid #1890ff;
}

.outline-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 横屏模式按钮样式 */
.landscape-btn {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #8a8a8a;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  overflow: hidden;
}

.landscape-btn.active {
  border: 1rpx solid #1890ff;
  background: #e6f7ff;
}

.landscape-icon {
  width: 48rpx;
  height: 48rpx;
}

.play-btn {
  background: #f5f5f5;
}

.control-options {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
}

.switch-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.switch-group text {
  font-size: 26rpx;
}

.small-switch {
  transform: scale(0.8);
  transform-origin: center;
}

.progress-container {
  padding: 0 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

/* 颜色选择器 */
.color-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.color-item {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid #eee;
}

.color-item.active {
  border: 4rpx solid #aa3bff;
}

.color-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

/* 笔画粗细选择器 */
.stroke-width-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.stroke-width-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.stroke-width-item.active {
  background: #f0f0f0;
  border-color: #aa3bff;
  box-shadow: 0 0 8rpx rgba(170, 91, 255, 0.4);
}

.stroke-circle {
  border-radius: 50%;
  background: #000;
}

/* 画笔类型选择器 */
.stroke-type-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.stroke-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1px solid transparent;
}

.stroke-type-item.active {
  background: #f0f0f0;
  border-color: #aa3bff;
}

.stroke-type-icon {
  font-size: 36rpx;
  line-height: 1;
}

.stroke-type-name {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 绘图工具栏 */
.draw-tools-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.draw-tool-btn {
  flex: 1;
  max-width: 160rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1rpx solid #ddd;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #333;
}

.draw-tool-btn.save-btn {
  background: linear-gradient(135deg, #66bb6a 0%, #43a047 100%);
  border: none;
  color: #fff;
}

/* 响应式样式 - 竖屏/移动端布局 */
@media (max-width: 900px) or (orientation: portrait) {
  .main-content {
    flex-direction: column;
  }

  .canvas-wrapper {
    flex: none;
    width: auto;
    height: auto;
    margin: 20rpx;
    padding: 20rpx;
  }

  .toolbar-wrapper {
    width: auto;
    border-left: none;
    border-top: 1rpx solid #eee;
    height: auto;
  }

  .control-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .control-bar.landscape-toolbar .control-bar {
    border-bottom: 1rpx solid #eee;
    border-top: none;
  }

  .progress-container {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .color-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .stroke-width-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .stroke-type-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }

  .draw-tools-bar {
    border-bottom: none;
    border-top: 1rpx solid #eee;
  }
}
