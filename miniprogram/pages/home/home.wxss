/* 一笔一笔 StepDraw - 小程序首页样式 */
.home {
  background: #fafafa;
  min-height: 100vh;
}

/* 导航栏 */
.navbar {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #aa3bff 0%, #7c3aed 100%);
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.navbar-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.navbar-text {
  display: flex;
  flex-direction: column;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
}

.navbar-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  padding: 32rpx 30rpx;
  background: #fafafa;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 分类卡片网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 0 20rpx 100rpx;
}

.category-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.category-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-char {
  font-size: 48rpx;
  line-height: 1;
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.category-count {
  font-size: 22rpx;
  color: #999;
  display: block;
}
