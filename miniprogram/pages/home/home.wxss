/* 一笔一笔 StepDraw - 小程序首页样式 */
.home {
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.category-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 16rpx;
  background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-char {
  font-size: 48rpx;
  line-height: 1;
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.category-count {
  font-size: 22rpx;
  color: #999;
  display: block;
}
