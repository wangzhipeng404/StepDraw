<!-- 一笔一笔 StepDraw - 小程序展示模式页 -->
<!-- 入口一：长按分类卡片进入；入口二：详情页"放映"按钮（先播图案，再回放用户笔迹） -->
<!-- 画布交互：单击 停止/启动播放，双击 显示/隐藏轮廓，长按 隐藏彩蛋-保存视频；页面下拉 重新播放 -->
<view class="show">
  <view class="main-content">
    <view class="canvas-wrapper">
      <view class="canvas-container">
        <view class="canvas-stack" style="width: {{canvasSize}}px; height: {{canvasSize}}px;">
          <!-- 录制用 WebGL 画布（隐藏彩蛋）：常驻页面、始终参与布局（不 display:none——
               隐藏状态取节点/建 WebGL 上下文会失败）。平时 opacity:0 垫在 2D 画布下面，
               录制时 2D 画布透明化、露出它：录制器录这个画布，同时用户能同步观察
               WebGL 绘制内容（排查"视频只有开头画面"是绘制还是抓帧问题）。 -->
          <canvas
            type="webgl"
            id="recordCanvas"
            canvas-id="recordCanvas"
            class="drawing-canvas"
            style="{{recording ? '' : 'opacity:0;'}}"
          ></canvas>
          <canvas
            type="2d"
            canvas-id="outlineCanvas"
            id="outlineCanvas"
            class="drawing-canvas"
            style="{{recording ? 'opacity:0;' : ''}}"
            bindtap="onCanvasTap"
            bindlongpress="onCanvasLongPress"
          ></canvas>
        </view>
        <!-- 步骤提示固定在右下角（纯展示，无交互）；放映回放阶段显示"你的作品" -->
        <view class="step-tip-overlay">
          <text class="tip-text">{{phaseText || (drawing && drawing.steps[currentStep] ? drawing.steps[currentStep].tip : '')}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
