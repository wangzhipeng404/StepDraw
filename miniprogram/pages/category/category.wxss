/* 一笔一笔 StepDraw - 分类列表页样式 */
.category-page {
  padding: 0 20rpx 20rpx 20rpx;
  padding-bottom: 100rpx;
}

.difficulty-filter {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 100;
  padding: 20rpx 0;
}

.difficulty-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 32rpx;
  background: #fff;
}

.difficulty-btn.active {
  background: #f0e6ff;
  border-color: #aa3bff;
  color: #aa3bff;
}

.drawing-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.drawing-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.thumbnail {
  aspect-ratio: 1;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px solid #f0f0f0;
}

.thumbnail-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.thumbnail-placeholder {
  width: 80%;
  height: 80%;
  background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-char {
  font-size: 80rpx;
  font-weight: 300;
  color: #999;
}

.drawing-info {
  padding: 16rpx;
}

.drawing-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.drawing-tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-difficulty {
  background: #fff3e0;
  color: #f57c00;
}

.empty-state,
.loading-state {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #999;
  font-size: 28rpx;
  grid-column: 1 / -1;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 20rpx;
  color: #999;
  font-size: 24rpx;
  grid-column: 1 / -1;
}
