.cp {
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
}

/* 预览条 */
.cp-preview {
  height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  transition: background 0.12s linear;
}

.cp-preview-text {
  padding: 6rpx 18rpx;
  background: rgba(0, 0, 0, 0.28);
  border-radius: 8rpx;
  color: #fff;
  font-size: 24rpx;
  font-family: Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}

/* SV 面板 */
.cp-sv {
  position: relative;
  height: 320rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: visible;
}

.cp-sv-dot {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.5);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

/* 色相条 */
.cp-hue {
  position: relative;
  height: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(
    to right,
    #ff0000 0%,
    #ffff00 17%,
    #00ff00 33%,
    #00ffff 50%,
    #0000ff 67%,
    #ff00ff 83%,
    #ff0000 100%
  );
}

.cp-hue-dot {
  position: absolute;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

/* HEX 输入行 */
.cp-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.cp-hex {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 20rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
}

.cp-hex-label {
  color: #999;
  font-size: 28rpx;
  margin-right: 6rpx;
}

.cp-hex-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
  font-family: Menlo, Consolas, monospace;
  letter-spacing: 2rpx;
}

.cp-swatch {
  width: 76rpx;
  height: 76rpx;
  margin-left: 16rpx;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}

/* 预设色板 */
.cp-presets {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.cp-preset {
  width: 56rpx;
  height: 56rpx;
  margin: 8rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.1s;
}

.cp-preset:active {
  transform: scale(0.88);
}