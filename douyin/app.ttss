/**
 * 一笔一笔 StepDraw - 小程序全局样式
 */
page {
  background-color: #fafafa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

/* 通用样式 */
.container {
  padding: 20rpx;
}

/* 按钮样式 */
.btn-primary {
  background-color: #aa3bff;
  color: #fff;
  border-radius: 8rpx;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333;
  border-radius: 8rpx;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 文字样式 */
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.tag-category {
  background-color: #e8f4fd;
  color: #1976d2;
}

.tag-difficulty {
  background-color: #fff3e0;
  color: #f57c00;
}
