<!-- 一笔一笔 StepDraw - 小程序首页（二级分类：分组 + 分类卡片） -->
<view class="home">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">选择你想画的图案</text>
    <text class="page-subtitle">先选主分类，再选具体图案</text>
  </view>

  <!-- 主分类卡片 -->
  <view class="group-grid">
    <block tt:for="{{groups}}" tt:key="id">
      <view
        class="group-card"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onGroupTap"
      >
        <view class="group-icon">
          <text class="group-emoji">{{item.emoji}}</text>
        </view>
        <text class="group-name">{{item.name}}</text>
        <text class="group-meta">{{item.categoryCount}} 个子分类 · {{item.count}} 个图案</text>
      </view>
    </block>
  </view>

  <!-- 底部 ICP 备案号：点击复制查询官网网址 -->
  <view class="icp-footer" bindtap="onIcpTap">
    <text class="icp-text">{{icpNumber}}</text>
  </view>
</view>
