<!-- 一笔一笔 StepDraw - 小程序收藏页 -->
<view class="favorite">
  <view class="header">
    <text class="title">我的收藏</text>
  </view>

  <view class="drawing-grid">
    <block tt:if="{{favoriteDrawings.length === 0}}">
      <view class="empty-state">
        <text class="empty-icon">⭐</text>
        <text class="empty-text">还没有收藏任何图案</text>
        <text class="empty-hint">去首页发现更多有趣的简笔画吧</text>
      </view>
    </block>
    <block tt:else>
      <block tt:for="{{favoriteDrawings}}" tt:key="id" tt:for-item="drawing">
        <view class="drawing-card" data-id="{{drawing.id}}" bindtap="onDrawingTap">
          <view class="thumbnail">
            <view class="thumbnail-placeholder">
              <text class="placeholder-char">{{drawing.name.charAt(0)}}</text>
            </view>
          </view>
          <view class="drawing-info">
            <text class="drawing-name">{{drawing.name}}</text>
          </view>
        </view>
      </block>
    </block>
  </view>
</view>
