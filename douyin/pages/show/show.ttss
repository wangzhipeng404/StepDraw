/* 一笔一笔 StepDraw - 小程序展示模式页样式 */
.show {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fafafa;
}

/* 主内容区域 */
.main-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

/* 画布区域 */
.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.canvas-container {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  height: 100%;
}

/* 画布叠放容器：固定尺寸，内部画布绝对定位占满 */
.canvas-stack {
  position: relative;
  background: #fff;
  border-radius: 8rpx;
  overflow: hidden;
}

.canvas-stack .drawing-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.drawing-canvas {
  background: #fff;
  width: 100%;
  height: 100%;
}

/* 步骤提示固定在右下角（纯展示） */
.step-tip-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  z-index: 10;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
